  "components": [
    {
      "name": "Default Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Keep and secondary actions: white, 2px ink border, square.",
      "html": "<button class=\"ds-btn\">Keep</button>",
      "css": ":root{--ground:#fff;--layer:#f2f3f4;--layer-strong:#e4e6e8;--ink:#111214;--ink-2:#4a4f57;--rule:#d4d7db;--rail:#0e2841;--rail-hover:#17375a;--rail-ink:#fff;--rail-ink-2:#b4c2d3;--primary:#0e2841;--primary-hover:#1a3d61;--danger:#c8102e;--warning:#e87722;--notice:#0057b8;--safe:#007a4d;--focus:#0057b8;--font-sign:'Barlow Condensed','Arial Narrow',sans-serif;--font-ui:'Barlow',system-ui,sans-serif;--ease-out:cubic-bezier(0.16,1,0.3,1);} .ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:38px;padding:7px 16px;border:2px solid #111214;background:#fff;color:#111214;font-family:'Barlow',system-ui,sans-serif;font-weight:600;font-size:0.92rem;border-radius:0;cursor:pointer;transition:background-color 150ms cubic-bezier(0.16,1,0.3,1),transform 150ms cubic-bezier(0.16,1,0.3,1);} .ds-btn:hover{background:#f2f3f4;} .ds-btn:active{transform:translateY(1px);} .ds-btn:focus-visible{outline:3px solid #0057b8;outline-offset:2px;}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Approve and the page's main action, in portal navy.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Approve</button>",
      "css": ":root{--ground:#fff;--layer:#f2f3f4;--layer-strong:#e4e6e8;--ink:#111214;--ink-2:#4a4f57;--rule:#d4d7db;--rail:#0e2841;--rail-hover:#17375a;--rail-ink:#fff;--rail-ink-2:#b4c2d3;--primary:#0e2841;--primary-hover:#1a3d61;--danger:#c8102e;--warning:#e87722;--notice:#0057b8;--safe:#007a4d;--focus:#0057b8;--font-sign:'Barlow Condensed','Arial Narrow',sans-serif;--font-ui:'Barlow',system-ui,sans-serif;--ease-out:cubic-bezier(0.16,1,0.3,1);} .ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:38px;padding:7px 16px;border:2px solid #111214;background:#fff;color:#111214;font-family:'Barlow',system-ui,sans-serif;font-weight:600;font-size:0.92rem;border-radius:0;cursor:pointer;transition:background-color 150ms cubic-bezier(0.16,1,0.3,1),transform 150ms cubic-bezier(0.16,1,0.3,1);} .ds-btn:hover{background:#f2f3f4;} .ds-btn:active{transform:translateY(1px);} .ds-btn:focus-visible{outline:3px solid #0057b8;outline-offset:2px;} .ds-btn-primary{background:#0e2841;border-color:#0e2841;color:#fff;} .ds-btn-primary:hover{background:#1a3d61;border-color:#1a3d61;}"
    },
    {
      "name": "Isolated Decision Pair",
      "kind": "custom",
      "refersTo": "button-primary",
      "description": "Keep and Approve with Approve set 22px apart behind a 1px rule so a mis-click can't delete.",
      "html": "<div class=\"ds-actions\"><button class=\"ds-btn\">Keep</button><button class=\"ds-btn ds-btn-primary ds-approve\">Approve</button></div>",
      "css": ":root{--ground:#fff;--layer:#f2f3f4;--layer-strong:#e4e6e8;--ink:#111214;--ink-2:#4a4f57;--rule:#d4d7db;--rail:#0e2841;--rail-hover:#17375a;--rail-ink:#fff;--rail-ink-2:#b4c2d3;--primary:#0e2841;--primary-hover:#1a3d61;--danger:#c8102e;--warning:#e87722;--notice:#0057b8;--safe:#007a4d;--focus:#0057b8;--font-sign:'Barlow Condensed','Arial Narrow',sans-serif;--font-ui:'Barlow',system-ui,sans-serif;--ease-out:cubic-bezier(0.16,1,0.3,1);} .ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:38px;padding:7px 16px;border:2px solid #111214;background:#fff;color:#111214;font-family:'Barlow',system-ui,sans-serif;font-weight:600;font-size:0.92rem;border-radius:0;cursor:pointer;transition:background-color 150ms cubic-bezier(0.16,1,0.3,1),transform 150ms cubic-bezier(0.16,1,0.3,1);} .ds-btn:hover{background:#f2f3f4;} .ds-btn:active{transform:translateY(1px);} .ds-btn:focus-visible{outline:3px solid #0057b8;outline-offset:2px;} .ds-btn-primary{background:#0e2841;border-color:#0e2841;color:#fff;} .ds-btn-primary:hover{background:#1a3d61;} .ds-actions{display:flex;align-items:center;} .ds-approve{margin-left:22px;position:relative;} .ds-approve::before{content:'';position:absolute;left:-13px;top:4px;bottom:4px;width:1px;background:#d4d7db;}"
    },
    {
      "name": "Chips",
      "kind": "chip",
      "refersTo": "chip-solid",
      "description": "Signs reduced to their band: navy for decisions, red for legal hold, blue for review, outline and dashed ghost for quiet states.",
      "html": "<div class=\"ds-row\"><span class=\"ds-chip ds-chip-solid\">DELETE</span><span class=\"ds-chip ds-chip-danger\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5 23 21.5H1z\" fill=\"#fff\"/><g fill=\"#c8102e\"><rect x=\"10.6\" y=\"8.6\" width=\"2.8\" height=\"6.8\"/><rect x=\"10.6\" y=\"16.8\" width=\"2.8\" height=\"2.6\"/></g></svg>LEGAL HOLD</span><span class=\"ds-chip ds-chip-notice\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"11\" fill=\"#fff\"/><rect x=\"10.6\" y=\"10\" width=\"2.8\" height=\"8\" fill=\"#000\"/><rect x=\"10.6\" y=\"5.6\" width=\"2.8\" height=\"2.8\" fill=\"#000\"/></svg>NEEDS REVIEW</span><span class=\"ds-chip ds-chip-plain\">RETAIN</span><span class=\"ds-chip ds-chip-ghost\">In grace period</span></div>",
      "css": ":root{--ground:#fff;--layer:#f2f3f4;--layer-strong:#e4e6e8;--ink:#111214;--ink-2:#4a4f57;--rule:#d4d7db;--rail:#0e2841;--rail-hover:#17375a;--rail-ink:#fff;--rail-ink-2:#b4c2d3;--primary:#0e2841;--primary-hover:#1a3d61;--danger:#c8102e;--warning:#e87722;--notice:#0057b8;--safe:#007a4d;--focus:#0057b8;--font-sign:'Barlow Condensed','Arial Narrow',sans-serif;--font-ui:'Barlow',system-ui,sans-serif;--ease-out:cubic-bezier(0.16,1,0.3,1);} .ds-chip{display:inline-flex;align-items:center;gap:6px;padding:2px 8px 2px 6px;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-weight:700;font-size:0.92rem;line-height:1.35;letter-spacing:0.03em;white-space:nowrap;border:2px solid transparent;border-radius:0;} .ds-chip svg{width:14px;height:14px;flex:none;} .ds-row{display:flex;gap:10px;flex-wrap:wrap;} .ds-chip-solid{background:#0e2841;color:#fff;} .ds-chip-danger{background:#c8102e;color:#fff;} .ds-chip-notice{background:#0057b8;color:#fff;} .ds-chip-plain{border-color:#111214;color:#111214;} .ds-chip-ghost{border-color:#d4d7db;border-style:dashed;color:#4a4f57;}"
    },
    {
      "name": "Legal Hold Sign",
      "kind": "custom",
      "refersTo": "sign-band-danger",
      "description": "Z535-format sign: signal-word band with drawn alert triangle over a plain message panel.",
      "html": "<div class=\"ds-sign ds-sign-danger\" role=\"note\"><div class=\"ds-sign-band\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5 23 21.5H1z\" fill=\"#fff\"/><g fill=\"#c8102e\"><rect x=\"10.6\" y=\"8.6\" width=\"2.8\" height=\"6.8\"/><rect x=\"10.6\" y=\"16.8\" width=\"2.8\" height=\"2.6\"/></g></svg><span>LEGAL HOLD</span></div><div class=\"ds-sign-body\">Files for <strong>Margaret Whitaker</strong> are under a legal hold. It's preserved until Compliance releases the hold.</div></div>",
      "css": ":root{--ground:#fff;--layer:#f2f3f4;--layer-strong:#e4e6e8;--ink:#111214;--ink-2:#4a4f57;--rule:#d4d7db;--rail:#0e2841;--rail-hover:#17375a;--rail-ink:#fff;--rail-ink-2:#b4c2d3;--primary:#0e2841;--primary-hover:#1a3d61;--danger:#c8102e;--warning:#e87722;--notice:#0057b8;--safe:#007a4d;--focus:#0057b8;--font-sign:'Barlow Condensed','Arial Narrow',sans-serif;--font-ui:'Barlow',system-ui,sans-serif;--ease-out:cubic-bezier(0.16,1,0.3,1);} .ds-sign{border:2px solid #000;background:#fff;max-width:76ch;font-family:'Barlow',system-ui,sans-serif;color:#111214;} .ds-sign-band{display:flex;align-items:center;gap:10px;padding:5px 12px;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-weight:800;font-size:1.15rem;letter-spacing:0.04em;line-height:1.2;} .ds-sign-band svg{width:20px;height:20px;flex:none;} .ds-sign-body{padding:10px 14px 12px;font-size:0.95rem;} .ds-sign-danger .ds-sign-band{background:#c8102e;color:#fff;}"
    },
    {
      "name": "Integrity Passed Sign",
      "kind": "custom",
      "refersTo": "sign-band-safe",
      "description": "Green verified sign with drawn check disc, used for the audit seal and the dashboard guarantee.",
      "html": "<div class=\"ds-sign ds-sign-safe\" role=\"note\"><div class=\"ds-sign-band\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"11\" fill=\"#fff\"/><path d=\"m6.5 12.5 3.6 3.6 7.4-8\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.8\" stroke-linecap=\"square\"/></svg><span>INTEGRITY CHECK PASSED</span></div><div class=\"ds-sign-body\">All <strong>12</strong> entries match their recorded hashes. Latest hash 5b32\u2026ca62.</div></div>",
      "css": ":root{--ground:#fff;--layer:#f2f3f4;--layer-strong:#e4e6e8;--ink:#111214;--ink-2:#4a4f57;--rule:#d4d7db;--rail:#0e2841;--rail-hover:#17375a;--rail-ink:#fff;--rail-ink-2:#b4c2d3;--primary:#0e2841;--primary-hover:#1a3d61;--danger:#c8102e;--warning:#e87722;--notice:#0057b8;--safe:#007a4d;--focus:#0057b8;--font-sign:'Barlow Condensed','Arial Narrow',sans-serif;--font-ui:'Barlow',system-ui,sans-serif;--ease-out:cubic-bezier(0.16,1,0.3,1);} .ds-sign{border:2px solid #000;background:#fff;max-width:76ch;font-family:'Barlow',system-ui,sans-serif;color:#111214;} .ds-sign-band{display:flex;align-items:center;gap:10px;padding:5px 12px;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-weight:800;font-size:1.15rem;letter-spacing:0.04em;line-height:1.2;} .ds-sign-band svg{width:20px;height:20px;flex:none;} .ds-sign-body{padding:10px 14px 12px;font-size:0.95rem;} .ds-sign-safe .ds-sign-band{background:#007a4d;color:#fff;}"
    },
    {
      "name": "Exposure Meter",
      "kind": "custom",
      "refersTo": "chip-solid",
      "description": "Navy three-segment meter plus level word and score; ranks rows without using safety colour.",
      "html": "<span class=\"ds-exposure\"><span class=\"ds-meter\" aria-hidden=\"true\"><span class=\"on\"></span><span class=\"on\"></span><span></span></span><span>MEDIUM</span><span class=\"ds-score\">27</span></span>",
      "css": ":root{--ground:#fff;--layer:#f2f3f4;--layer-strong:#e4e6e8;--ink:#111214;--ink-2:#4a4f57;--rule:#d4d7db;--rail:#0e2841;--rail-hover:#17375a;--rail-ink:#fff;--rail-ink-2:#b4c2d3;--primary:#0e2841;--primary-hover:#1a3d61;--danger:#c8102e;--warning:#e87722;--notice:#0057b8;--safe:#007a4d;--focus:#0057b8;--font-sign:'Barlow Condensed','Arial Narrow',sans-serif;--font-ui:'Barlow',system-ui,sans-serif;--ease-out:cubic-bezier(0.16,1,0.3,1);} .ds-exposure{display:inline-flex;align-items:center;gap:7px;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-weight:700;font-size:0.95rem;letter-spacing:0.03em;color:#111214;} .ds-meter{display:inline-flex;gap:2px;} .ds-meter>span{width:6px;height:14px;border:1.5px solid #0e2841;} .ds-meter>span.on{background:#0e2841;} .ds-score{font-family:'Barlow',system-ui,sans-serif;font-weight:600;font-size:0.78rem;color:#4a4f57;}"
    },
    {
      "name": "Moved Marker",
      "kind": "custom",
      "refersTo": "chip-solid",
      "description": "'Up N': the row moved up N places after the scan; clears once the row is seen.",
      "html": "<span class=\"ds-moved\" aria-label=\"Moved up 9 places after the scan\">Up 9</span>",
