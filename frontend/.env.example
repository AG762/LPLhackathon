VITE_API_URL=https://7xijdl7jzooaoahckeuqbrcsye0iqnhz.lambda-url.us-east-1.on.aws
# mock | live. Can also be switched in the sidebar.
VITE_API_MODE=mock
# true only when the stack is deployed with DemoControls=true (audit tamper rehearsal)
VITE_DEMO_CONTROLS=true
# Set by `npm run online` for the online VS Code proxy (/ports/5173); leave unset for npm run dev
# VITE_ROUTER_BASE=/ports/5173
# Sign-in (docs/login.md). From the stack outputs; leave unset to run without sign-in.
# Only used in Live mode. Demo mode never signs in.
# VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
# VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_COGNITO_DOMAIN=https://shredsafe-123456789012.auth.us-east-1.amazoncognito.com
